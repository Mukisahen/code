DATABASE_URL="postgresql://farmbhade:changeme@localhost:5432/farmbhade?schema=public"
# Must be at least 32 characters — generate with: openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-chars"
PORT=4000
UPLOADS_DIR="./uploads"
PUBLIC_UPLOADS_BASE_URL="http://localhost:4000/uploads"
CORS_ORIGIN="http://localhost:5173"

# --- Used by docker-compose.yml only (VPS deployment) ---
# POSTGRES_PASSWORD="changeme"
# API_DOMAIN="api.yourdomain.com"

# --- Used by `npm run create-admin` only (bootstraps the one supreme admin;
#     never commit real values, and unset these again once you've run it) ---
# SUPER_ADMIN_PHONE="+256700000001"
# SUPER_ADMIN_PASSWORD="a long random password, at least 12 characters"
# SUPER_ADMIN_NAME="Farm Bhade Admin"
# SUPER_ADMIN_DISTRICT="Kampala"

# --- Optional: enables automatic market-price updates (see
#     src/lib/marketPriceFeed.ts). Free key from https://www.alphavantage.co/support/#api-key
#     — without it, prices stay admin-entered only, which is a fully
#     supported, non-degraded mode ---
# ALPHA_VANTAGE_API_KEY="your-free-alphavantage-key"

# --- Optional: powers the Ask AI chatbot with real Claude responses (see
#     src/lib/claudeAssistant.ts). Get a key from https://console.anthropic.com/
#     — without it, the chatbot falls back to the frontend's local
#     keyword-matched FAQ, which is a fully supported, non-degraded mode ---
# ANTHROPIC_API_KEY="your-anthropic-api-key"
